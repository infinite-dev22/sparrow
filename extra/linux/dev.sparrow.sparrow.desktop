[Desktop Entry]
Version=1.0
Type=Application

Name=Sparrow
Comment=Dart and Flutter IDE
Categories=Development;IDE;
GenericName=Dart and Flutter IDE
StartupWMClass=dev.sparrow.sparrow

Icon=dev.sparrow.sparrow
Exec=sparrow %F
Terminal=false
MimeType=text/x-dart;application/x-dart;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sparrow --new %F
Icon=dev.sparrow.sparrow
