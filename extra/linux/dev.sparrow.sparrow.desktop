[Desktop Entry]
Version=1.0
Type=Application

Name=sparrow
Comment=Lightning-fast and powerful code editor written in Rust
Categories=Development;IDE;
GenericName=Code Editor
StartupWMClass=sparrow

Icon=dev.sparrow.sparrow
Exec=sparrow %F
Terminal=false
MimeType=text/plain;inode/directory;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=sparrow --new %F
Icon=dev.sparrow.sparrow
