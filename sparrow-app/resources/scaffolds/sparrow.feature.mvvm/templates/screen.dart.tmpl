    if (widget.viewModel == null) _model.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => Scaffold(
    appBar: AppBar(title: const Text('{{name}}')),
    body: ListenableBuilder(
      listenable: _model,
      builder: (context, _) {
        if (_model.loading) {
          return const Center(child: CircularProgressIndicator());
